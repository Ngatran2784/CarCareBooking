<%@ page language="java" contentType="text/html; charset=UTF-8" pageEncoding="UTF-8"%>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<aside class="sidebar p-3 d-none d-md-block text-white">
    <div class="sidebar-heading">Tổng quan & Hệ thống</div>
    <ul class="nav flex-column mb-2">
        <li class="nav-item">
            <a class="nav-link" href="${pageContext.request.contextPath}/home">
                <i class="bi bi-speedometer2"></i> Bảng điều khiển
            </a>
        </li>
        <c:if test="${sessionScope.currentUser != null && (sessionScope.currentUser.hasRole('ADMIN') || sessionScope.currentUser.hasRole('MANAGER'))}">
            <li class="nav-item">
                <a class="nav-link" href="${pageContext.request.contextPath}/users">
                    <i class="bi bi-people"></i> Tài khoản người dùng
                </a>
            </li>
        </c:if>
    </ul>

    <c:if test="${sessionScope.currentUser != null && (sessionScope.currentUser.hasRole('ADMIN') || sessionScope.currentUser.hasRole('MANAGER') || sessionScope.currentUser.hasRole('RECEPTIONIST'))}">
        <div class="sidebar-heading">Khách hàng & Dịch vụ</div>
        <ul class="nav flex-column mb-2">
            <li class="nav-item">
                <a class="nav-link" href="${pageContext.request.contextPath}/customers">
                    <i class="bi bi-person-vcard"></i> Hồ sơ khách hàng
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link" href="${pageContext.request.contextPath}/vehicles">
                    <i class="bi bi-truck-front"></i> Xe khách hàng
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link" href="${pageContext.request.contextPath}/services">
                    <i class="bi bi-card-checklist"></i> Bảng giá dịch vụ
                </a>
            </li>
        </ul>
    </c:if>

    <c:if test="${sessionScope.currentUser != null && (sessionScope.currentUser.hasRole('ADMIN') || sessionScope.currentUser.hasRole('MANAGER'))}">
        <div class="sidebar-heading">Vận hành & Khoang bãi</div>
        <ul class="nav flex-column mb-2">
            <li class="nav-item">
                <a class="nav-link" href="${pageContext.request.contextPath}/staff">
                    <i class="bi bi-person-gear"></i> Nhân sự & Kỹ thuật
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link" href="${pageContext.request.contextPath}/bays">
                    <i class="bi bi-bounding-box"></i> Khoang / Cầu dịch vụ
                </a>
            </li>
        </ul>
    </c:if>

    <div class="sidebar-heading">Đặt lịch & Tiếp nhận</div>
    <ul class="nav flex-column mb-2">
        <li class="nav-item">
            <a class="nav-link" href="${pageContext.request.contextPath}/bookings">
                <i class="bi bi-calendar2-plus"></i> Đặt lịch hẹn
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link" href="${pageContext.request.contextPath}/booking-history">
                <i class="bi bi-clock-history"></i> Lịch sử đặt lịch
            </a>
        </li>
        <c:if test="${sessionScope.currentUser != null && (sessionScope.currentUser.hasRole('ADMIN') || sessionScope.currentUser.hasRole('MANAGER') || sessionScope.currentUser.hasRole('RECEPTIONIST'))}">
            <li class="nav-item">
                <a class="nav-link" href="${pageContext.request.contextPath}/checkin">
                    <i class="bi bi-box-arrow-in-down-right"></i> Tiếp nhận xe (Check-in)
                </a>
            </li>
        </c:if>
    </ul>

    <c:if test="${sessionScope.currentUser != null && (sessionScope.currentUser.hasRole('ADMIN') || sessionScope.currentUser.hasRole('MANAGER') || sessionScope.currentUser.hasRole('RECEPTIONIST') || sessionScope.currentUser.hasRole('TECHNICIAN'))}">
        <div class="sidebar-heading">Điều phối & Thi công</div>
        <ul class="nav flex-column mb-2">
            <c:if test="${!sessionScope.currentUser.hasRole('TECHNICIAN')}">
                <li class="nav-item">
                    <a class="nav-link" href="${pageContext.request.contextPath}/dispatch">
                        <i class="bi bi-diagram-3"></i> Bảng điều phối xưởng
                    </a>
                </li>
            </c:if>
            <li class="nav-item">
                <a class="nav-link" href="${pageContext.request.contextPath}/jobs">
                    <i class="bi bi-file-earmark-medical"></i> Thẻ công việc (Job Card)
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link" href="${pageContext.request.contextPath}/inspections">
                    <i class="bi bi-camera"></i> Biên bản & Ảnh xe
                </a>
            </li>
        </ul>

        <div class="sidebar-heading">Kiểm định & Phát sinh</div>
        <ul class="nav flex-column mb-2">
            <li class="nav-item">
                <a class="nav-link" href="${pageContext.request.contextPath}/additional-services">
                    <i class="bi bi-plus-circle"></i> Dịch vụ phát sinh
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link" href="${pageContext.request.contextPath}/quality-checks">
                    <i class="bi bi-patch-check"></i> Nghiệm thu chất lượng (QC)
                </a>
            </li>
        </ul>
    </c:if>

    <div class="sidebar-heading">Tài chính & Đánh giá</div>
    <ul class="nav flex-column mb-2">
        <c:if test="${sessionScope.currentUser != null && (sessionScope.currentUser.hasRole('ADMIN') || sessionScope.currentUser.hasRole('MANAGER') || sessionScope.currentUser.hasRole('RECEPTIONIST'))}">
            <li class="nav-item">
                <a class="nav-link" href="${pageContext.request.contextPath}/invoices">
                    <i class="bi bi-receipt"></i> Hóa đơn thanh toán
                </a>
            </li>
        </c:if>
        <li class="nav-item">
            <a class="nav-link" href="${pageContext.request.contextPath}/reviews">
                <i class="bi bi-star"></i> Đánh giá phản hồi
            </a>
        </li>
        <c:if test="${sessionScope.currentUser != null && (sessionScope.currentUser.hasRole('ADMIN') || sessionScope.currentUser.hasRole('MANAGER'))}">
            <li class="nav-item">
                <a class="nav-link" href="${pageContext.request.contextPath}/reports">
                    <i class="bi bi-graph-up"></i> Báo cáo thống kê
                </a>
            </li>
        </c:if>
    </ul>
</aside>
