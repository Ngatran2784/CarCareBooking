<%@ page language="java" contentType="text/html; charset=UTF-8" pageEncoding="UTF-8"%>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%@ taglib prefix="fmt" uri="jakarta.tags.fmt" %>
<fmt:setLocale value="vi_VN"/>
<c:set var="pageTitle" value="Dịch vụ & Bảng giá"/><%@ include file="../layout/header.jspf" %>
<%@ include file="../layout/sidebar.jspf" %>
<main class="content-wrapper workspace-page"><div class="container-fluid">

<div class="page-eyebrow">Quản lý danh mục</div><div class="page-hero"><div><h3 class="fw-bold mb-1">Dịch vụ & Bảng giá</h3><p>Mọi dịch vụ, một nơi quản lý. Cập nhật giá và thời lượng để xưởng luôn vận hành nhịp nhàng.</p></div><c:if test="${isAdminOrManager}"><button type="button" class="btn btn-primary" data-open-editor="serviceEditorPanel"><i class="bi bi-plus-lg me-2"></i>Thêm dịch vụ</button></c:if></div><nav class="workspace-nav" aria-label="Danh mục và nhân sự"><a href="${ctx}/services" class="active" aria-current="page"><i class="bi bi-grid me-2"></i>Dịch vụ & Bảng giá</a><c:if test="${isAdminOrManager}"><a href="${ctx}/bays" class=""><i class="bi bi-shop me-2"></i>Khoang dịch vụ</a></c:if><c:if test="${isAdminOrManager}"><a href="${ctx}/staff" class=""><i class="bi bi-people me-2"></i>Nhân sự & Ca làm</a></c:if></nav><c:if test="${not empty error}"><div class="alert alert-danger" role="alert"><c:out value="${error}"/></div></c:if>
<c:if test="${not empty success}"><div class="alert alert-success" role="status"><c:out value="${success}"/></div></c:if>
<c:if test="${ready}">
<c:set var="activeCount" value="0"/><c:forEach var="service" items="${items}"><c:if test="${service.status == 'ACTIVE'}"><c:set var="activeCount" value="${activeCount + 1}"/></c:if></c:forEach><div class="metric-grid"><div class="metric"><i class="bi bi-grid"></i><div><strong>${items.size()}</strong><span>Dịch vụ trong danh mục</span></div></div><div class="metric"><i class="bi bi-check2-circle"></i><div><strong>${activeCount}</strong><span>Đang cung cấp</span></div></div><div class="metric"><i class="bi bi-pause-circle"></i><div><strong>${items.size() - activeCount}</strong><span>Ngừng cung cấp</span></div></div></div><c:if test="${isAdminOrManager}"><details class="editor-panel" id="serviceEditorPanel" ${not empty form || not empty param.edit ? 'open' : ''}><summary><i class="bi bi-pencil-square me-2"></i>Thông tin dịch vụ</summary><%@ include file="form.jsp" %></details></c:if>
<section class="card mb-4"><div class="card-body">
<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-3"><h5 class="mb-0">Danh mục dịch vụ <span class="badge bg-primary">${items.size()}</span></h5><div class="search-field"><i class="bi bi-search"></i><label class="visually-hidden" for="serviceSearch">Tìm dịch vụ</label><input class="form-control" id="serviceSearch" type="search" placeholder="Tìm tên, mô tả, trạng thái..." data-filter-table="servicesTable"></div></div>
<div class="d-flex flex-wrap gap-2 mb-3"><label class="visually-hidden" for="serviceStatusFilter">Lọc trạng thái dịch vụ</label><select class="form-select w-auto" id="serviceStatusFilter" data-status-filter="servicesTable"><option value="">Tất cả trạng thái</option><option value="ACTIVE">Đang cung cấp</option><option value="INACTIVE">Ngừng cung cấp</option></select><span class="text-muted small align-self-center" data-result-count="servicesTable" aria-live="polite"></span></div><div class="table-responsive"><table class="table align-middle" id="servicesTable" data-empty-message="Không tìm thấy dịch vụ phù hợp."><thead><tr><th>Dịch vụ</th><th class="text-nowrap">Giá (VNĐ)</th><th>Thời lượng</th><th>Trạng thái</th><c:if test="${isAdminOrManager}"><th>Thao tác</th></c:if></tr></thead><tbody>
<c:forEach var="r" items="${items}"><tr data-record-id="${r.service_id}" data-status="${r.status}"><td><strong><c:out value="${r.service_name}"/></strong><div class="text-muted small text-break" style="max-width:480px;white-space:pre-wrap"><c:out value="${r.description}"/></div></td><td class="text-nowrap"><fmt:formatNumber value="${r.base_price}" maxFractionDigits="2"/></td><td class="text-nowrap">${r.estimated_duration_minutes} phút</td><td><span class="badge ${r.status == 'ACTIVE' ? 'bg-success-subtle text-success' : 'bg-secondary-subtle text-secondary'}">${r.status == 'ACTIVE' ? 'Đang cung cấp' : 'Ngừng cung cấp'}</span></td>
<c:if test="${isAdminOrManager}"><td class="text-nowrap"><a class="btn btn-sm btn-outline-primary" href="${ctx}/services?edit=${r.service_id}#serviceEditor">Sửa</a>
<form class="d-inline catalog-delete" method="post" action="${ctx}/services"><input type="hidden" name="csrf" value="${sessionScope.catalogCsrf}"><input type="hidden" name="action" value="deleteService"><input type="hidden" name="id" value="${r.service_id}"><button class="btn btn-sm btn-outline-danger">Xóa</button></form></td></c:if></tr></c:forEach>
<c:if test="${empty items}"><tr><td colspan="5" class="text-center text-muted py-4">Chưa có dịch vụ.</td></tr></c:if>
</tbody></table></div><p class="small text-muted mb-0">Dịch vụ đã được sử dụng hoặc có lịch sử giá cần chuyển sang Ngừng cung cấp thay vì xóa.</p>
</div></section>
<c:if test="${isAdminOrManager}"><section class="card mb-4"><div class="card-body"><h5 class="mb-3">Lịch sử thay đổi giá</h5><div class="table-responsive"><table class="table align-middle" id="pricesTable"><thead><tr><th>Dịch vụ</th><th>Giá cũ (VNĐ)</th><th>Giá mới (VNĐ)</th><th>Thời điểm</th><th>Người thay đổi</th></tr></thead><tbody>
<c:forEach var="r" items="${details}"><tr><td><c:out value="${r.service_name}"/></td><td><fmt:formatNumber value="${r.old_price}" maxFractionDigits="2"/></td><td><fmt:formatNumber value="${r.new_price}" maxFractionDigits="2"/></td><td class="text-nowrap"><fmt:formatDate value="${r.effective_date}" pattern="dd/MM/yyyy HH:mm"/></td><td><c:out value="${empty r.full_name ? 'Hệ thống' : r.full_name}"/></td></tr></c:forEach>
<c:if test="${empty details}"><tr><td colspan="5" class="text-center text-muted py-4">Chưa có thay đổi giá.</td></tr></c:if>
</tbody></table></div></div></section></c:if></c:if></div></main><script src="${ctx}/assets/js/catalog.js" defer></script><%@ include file="../layout/footer.jspf" %>